<?xml version="1.0" encoding="utf-8"?>
<!-- Journal backups are full copies of financial data; keep them out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="backups" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups" />
    </device-transfer>
</data-extraction-rules>
